# Studio application
STUDIO_SECRET_KEY=change-me-to-a-long-random-string
STUDIO_ADMIN_EMAIL=admin@localhost
STUDIO_ADMIN_PASSWORD=change-me
STUDIO_SESSION_COOKIE=studio_session
STUDIO_CSRF_COOKIE=studio_csrf
STUDIO_PREVIEW_MAX_ROWS=100
STUDIO_PREVIEW_TIMEOUT_SECONDS=15
STUDIO_MAX_ROWS=2000000
STUDIO_STATEMENT_TIMEOUT_MS=300000

# Studio metadata database (separate DB on warehouse-db)
STUDIO_DATABASE_URL=postgresql+psycopg://studio_app:change-me@warehouse-db:5432/pipeline_studio

# Approved connection DSNs — never sent to the browser
LUDO_DB_NAME=ludo
LUDO_ETL_PASSWORD=change-me
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse_user
WAREHOUSE_PASSWORD=change-me

# Airflow 2.10.5 REST API (private Docker DNS only)
AIRFLOW_API_BASE_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_API_USERNAME=studio_api
AIRFLOW_API_PASSWORD=change-me

# Filesystem publisher
MANAGED_JOBS_DIR=/opt/airflow/managed-jobs
